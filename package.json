{
  "name": "x402-cannastack",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/migrate.ts --optional && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed --workers=1 --project=chromium",
    "test:e2e:demo": "PLAYWRIGHT_DEMO=1 PLAYWRIGHT_TILE_WINDOWS=1 DEMO_SLOWMO=750 playwright test tests/cannastack-demo.spec.ts --headed --workers=2 --fully-parallel --project=chromium --reporter=line",
    "test:e2e:ui": "playwright test --ui",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:purge-derived": "tsx scripts/purge-derived-data.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@x402/core": "^2.18.0",
    "@x402/evm": "^2.18.0",
    "@x402/extensions": "2.18.0",
    "@x402/next": "^2.18.0",
    "dotenv": "^17.4.2",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ajv": "^8.20.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.10",
    "pg": "^8.21.0",
    "tailwindcss": "^4",
    "tsx": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "postcss": "8.5.12",
    "viem": "2.55.2",
    "ws": "8.21.0"
  }
}
