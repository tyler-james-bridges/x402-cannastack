# Neon Postgres
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Local dev/test only: route the Neon driver's HTTP queries to a local proxy
# (e.g. http://localhost:4444/sql in front of plain Postgres). Never set in prod.
NEON_HTTP_FETCH_ENDPOINT=

# Wallet that receives per-request payments for active menu processors
CANNASTACK_PAY_TO=
# Base mainnet facilitator (must advertise eip155:8453 in /supported,
# or @x402/next rejects the route). The default supports exact on Base
# mainnet without facilitator authentication.
X402_FACILITATOR_BASE=https://facilitator.payai.network
# Local development only. Production ignores this payment bypass.
X402_PREVIEW_MODE=
